# Postgres connection string (Railway: reference ${{Postgres.DATABASE_URL}})
DATABASE_URL=postgres://davada:davada@127.0.0.1:5432/davada
# Long random string used to sign login cookies
PAYLOAD_SECRET=change-me
# Public address of the site, e.g. https://davadaagro.in (optional)
SITE_URL=
# First admin account, created on first boot when no users exist
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=પ્રતીકભાઈ
# Where uploaded photos are stored (Railway: the volume mount, /data/media)
MEDIA_DIR=
